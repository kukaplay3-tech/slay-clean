{
  "manifest_version": 3,
  "name": "SLAY Clean",
  "version": "1.0.0",
  "description": "Убирает брендинг Winline со страниц Slay Award.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://slay-award.ru/*", "https://www.slay-award.ru/*"],
      "css": ["hero.css", "clean.css"],
      "js": ["clean.js"],
      "run_at": "document_start"
    }
  ]
}
